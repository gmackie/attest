{
  "name": "attest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @attest/web dev",
    "build": "pnpm --filter @attest/contracts build && pnpm --filter @attest/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "proof:smoke": "pnpm --filter @attest/proofs proof:smoke",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy:web": "pnpm check && wrangler deploy",
    "attest": "tsx packages/cli/src/launch.mjs"
  },
  "devDependencies": {
    "@pcd/pod": "0.5.1",
    "@types/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.83.0"
  }
}
