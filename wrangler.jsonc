{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attest-demo",
  "account_id": "c07a7e704db1808e1fff91bed2b1cd49",
  "compatibility_date": "2026-10-08",
  "main": "apps/issuer/src/index.ts",
  "alias": {
    "snarkjs": "./apps/issuer/src/groth16-worker.ts",
    "fastfile": "./apps/issuer/src/verification-keys.ts",
  },
  "limits": { "cpu_ms": 30000 },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SEPOLIA_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
    // Independent second provider: decision reads must agree across both (ATTE-27).
    "SEPOLIA_RPC_URL_SECONDARY": "https://sepolia.gateway.tenderly.co",
    // Demo PEP (ATTE-20): a stand-in for Gatekeeper's attest PEP under /api/demo-pep. See specs/vendor-portal-demo.md.
    "DEMO_PEP_ISSUER": "https://attest.gmac.io/api/demo-pep",
    // Gatekeeper-style verifiers[] entry. Copy `keys` from https://verify.attest.gmac.io/.well-known/jwks.json
    // ([{"kid", "publicKey": {kty, crv, x, y}}]); until then the PEP answers challenges with attest_not_configured.
    // The digest is apps/verifier's catalog digest for demo.insurance.cgl.min-2m (a test keeps it in sync).
    "DEMO_PEP_VERIFIER": "{\"issuer\":\"https://verify.attest.gmac.io\",\"endpoint\":\"https://verify.attest.gmac.io/v1/presentations\",\"keys\":[],\"requirements\":[{\"id\":\"demo.insurance.cgl.min-2m\",\"digest\":\"2251414534a86a6cbe9b53d6a030b6fbe4437f8d1e7341ec0bc91246846b3d20\"}]}",
    // Further IdPs for the caller's access token (seam for Nathan, NATH-15). The demo identity is built in.
    "DEMO_PEP_IDENTITY_PROVIDERS": "[]",
  },
  // Secrets (wrangler secret put): DEMO_PEP_SIGNING_KEY and DEMO_IDENTITY_SIGNING_KEY,
  // each {"active": kid, "keys": [{kid, privateKey}]}. Generate with apps/issuer/scripts/new-demo-pep-key.mjs.
  "durable_objects": {
    "bindings": [
      { "name": "INSTITUTIONS", "class_name": "InstitutionService" },
      { "name": "DEMO_PEP", "class_name": "DemoPepService" },
    ],
  },
  "migrations": [
    { "tag": "institution-v2", "new_sqlite_classes": ["InstitutionService"] },
    { "tag": "demo-pep-v1", "new_sqlite_classes": ["DemoPepService"] },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "attest.gmac.io", "custom_domain": true }],
}
