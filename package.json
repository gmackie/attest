{
  "name": "attest",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.1",
    "pnpm": "^12.21.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @attest/web dev",
    "build": "pnpm --filter @attest/contracts build && pnpm --filter @attest/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "proof:smoke": "pnpm --filter @attest/proofs proof:smoke",
    "check": "pnpm --filter @attest/contracts build && pnpm typecheck && pnpm test && pnpm build",
    "deploy:web": "pnpm check && wrangler deploy",
    "attest": "tsx packages/cli/src/launch.mjs"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@pcd/pod": "0.5.1",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  }
}
