{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest.invalid/schemas/deployment-manifest/v1",
  "title": "Attest pinned deployment manifest (contracts/deployments/<chainId>.json)",
  "description": "Validated by packages/chain-evm/src/manifest.ts parseDeploymentManifest. Clients refuse contracts whose chain ID or runtime code hash differ from the pinned record, or that have no record.",
  "type": "object",
  "required": ["schema", "chainId", "deployments"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "attest.deployment-manifest/v1" },
    "chainId": { "type": "integer", "minimum": 1 },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract", "address", "deployTx", "blockNumber", "runtimeCodeHash", "sourceDigest", "compiler"],
        "additionalProperties": false,
        "properties": {
          "contract": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "deployTx": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "blockNumber": { "type": "integer", "minimum": 0 },
          "runtimeCodeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "description": "keccak256 of deployed runtime bytecode (EXTCODEHASH). Must not be keccak256 of empty code." },
          "sourceDigest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "description": "sha256 of the exact Solidity source file compiled." },
          "compiler": {
            "type": "object",
            "required": ["solc", "evmVersion", "optimizer"],
            "additionalProperties": false,
            "properties": {
              "solc": { "type": "string" },
              "evmVersion": { "type": "string" },
              "optimizer": {
                "type": "object",
                "required": ["enabled"],
                "additionalProperties": false,
                "properties": { "enabled": { "type": "boolean" }, "runs": { "type": "integer" } }
              }
            }
          },
          "administrator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "description": "Governance root at deployment (informational)." }
        }
      }
    }
  }
}
