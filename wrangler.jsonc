{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attest-demo",
  "account_id": "c07a7e704db1808e1fff91bed2b1cd49",
  "compatibility_date": "2026-10-08",
  "main": "apps/issuer/src/index.ts",
  "alias": {
    "snarkjs": "./apps/issuer/src/groth16-worker.ts",
    "fastfile": "./apps/issuer/src/verification-keys.ts",
  },
  "limits": { "cpu_ms": 30000 },
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "SEPOLIA_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com" },
  "durable_objects": {
    "bindings": [
      { "name": "INSTITUTIONS", "class_name": "InstitutionService" },
    ],
  },
  "migrations": [
    { "tag": "institution-v2", "new_sqlite_classes": ["InstitutionService"] },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "attest.gmac.io", "custom_domain": true }],
}
