{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Attest verifier service (ATTE-28). Separate Worker from attest-demo (root wrangler.jsonc).
  "name": "attest-verifier",
  "account_id": "c07a7e704db1808e1fff91bed2b1cd49",
  "compatibility_date": "2026-11-17",
  "main": "src/index.ts",
  // GPC verification in a Worker: the same shims as attest-demo (noble BN254 Groth16 verifier,
  // pinned verification keys). Nothing is fetched to verify a proof.
  "alias": {
    "snarkjs": "../issuer/src/groth16-worker.ts",
    "fastfile": "../issuer/src/verification-keys.ts",
  },
  "limits": { "cpu_ms": 30000 },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "VERIFIER_ID": "https://verify.attest.gmac.io",
    "SEPOLIA_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
    // Independent second provider: chain reads must agree across both.
    "SEPOLIA_RPC_URL_SECONDARY": "https://sepolia.gateway.tenderly.co",
    // "finalized" or "confirmations:<n>". 3 confirmations follows ATTE-27; pilots should use finalized.
    "CHAIN_FINALITY": "confirmations:3",
    // Pinned Gatekeeper tenant request keys, from GET <gatekeeper>/api/attest/tenants/<tenant>/jwks.
    // JSON [{"issuer": "https://...", "keys": [{"kid": "...", "publicKey": {P-256 public JWK}}]}]
    "TRUSTED_PEPS": "[{\"issuer\":\"https://attest.gmac.io/api/demo-pep\",\"keys\":[{\"kid\":\"demo-pep-request-2026-11-22-221d3da8\",\"publicKey\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"UXXfYoggNT11exzmSRTBZuJj0n4ejL-BFsx55vew1cw\",\"y\":\"sb9ioOiFtrryTQrncSzZ9kS0oltgh--oNZONkweuicM\"}}]},{\"issuer\":\"https://gatekeeper.gmac.io/tenants/attest-demo\",\"keys\":[{\"kid\":\"attest-demo-2026-11-22-59dd6263\",\"publicKey\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"l8XdRu99I9WxJynueg5u9GjiGGLROiT12lRFpXDPRMk\",\"y\":\"4UWkEu7tROGx1hpiG20Kd-jxRkOg6uWXJKeb-NEXlKE\"}}]}]",
    // IdPs whose access tokens authenticate holder enrollment.
    // JSON [{"issuer": "https://...", "jwksUri": "https://...", "audience": "...", "clientId"?, "bindingTtlMs"?}]
    // The demo identity (ATTE-20) must carry clientId "attest-vendor-portal-demo" and bindingTtlMs 86400000.
    "IDENTITY_PROVIDERS": "[{\"issuer\":\"https://attest.gmac.io/api/demo-pep/identity\",\"jwksUri\":\"https://attest.gmac.io/api/demo-pep/identity/jwks\",\"audience\":\"https://verify.attest.gmac.io\",\"clientId\":\"attest-vendor-portal-demo\",\"bindingTtlMs\":86400000},{\"issuer\":\"https://gatekeeper.gmac.io/demo-idp\",\"jwksUri\":\"https://gatekeeper.gmac.io/demo-idp/jwks.json\",\"audience\":\"https://gatekeeper.gmac.io/api\",\"clientId\":\"gatekeeper-demo\",\"bindingTtlMs\":86400000}]",
    // Browser origins allowed to call the verifier cross-origin (bearer tokens only, never cookies).
    // The attest.gmac.io vendor portal (ATTE-20) enrolls and presents from the browser.
    "CORS_ORIGINS": "[\"https://attest.gmac.io\"]",
  },
  // Secret (wrangler secret put RESULT_SIGNING_KEYS): {"active": kid, "keys": [{"kid", "privateKey"}]}.
  // Generate with: node apps/verifier/scripts/new-result-key.mjs
  // Per-IP limit on POST /v1/enrollments (ATTE-20): anonymous demo identities must not drive enrollment load.
  "ratelimits": [
    { "name": "ENROLLMENT_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REPLAY", "class_name": "ReplayStore" },
      { "name": "ENROLLMENTS", "class_name": "EnrollmentStore" },
    ],
  },
  "migrations": [
    { "tag": "verifier-v1", "new_sqlite_classes": ["ReplayStore", "EnrollmentStore"] },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "verify.attest.gmac.io", "custom_domain": true }],
}
